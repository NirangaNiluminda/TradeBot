# Copy this file to the project root as `.env` and fill in your keys:
#     cp config/.env.example .env
# `.env` is listed in .gitignore, so it will never be committed.

# Binance Spot TESTNET (fake money) — https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance LIVE (real money) — leave empty until Phase 6.
# Permissions: Reading + Spot Trading ONLY. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# LLM providers for the news risk check (free tiers). Order is set in config.yaml.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Telegram (optional): alerts + /status /pause /stop + Approve/Reject buttons
#  1. In Telegram, message @BotFather -> /newbot -> copy the token below
#  2. Send "hi" to your new bot, then run:  uv run tradebot telegram-setup
#  3. Copy the TELEGRAM_CHAT_ID it prints below
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
