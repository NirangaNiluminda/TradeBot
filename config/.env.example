# Copy this file to the project root as `.env` and fill in your keys:
#     cp config/.env.example .env
# `.env` is listed in .gitignore, so it will never be committed.

# Binance Spot TESTNET (fake money) — https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance LIVE (real money) — leave empty until Phase 6.
# Permissions: Reading + Spot Trading ONLY. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Phase 2 — LLM providers (free tiers)
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Phase 4 — Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
